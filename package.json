{
  "name": "sagu-sdk",
  "version": "0.1.0",
  "description": "An open-source, vendor-agnostic TypeScript SDK for building tool-using, multi-agent LLM applications.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "agent",
    "ai",
    "llm",
    "multi-agent",
    "tools",
    "guardrails",
    "memory",
    "neo4j",
    "typescript"
  ],
  "author": "Sarthak Gupta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeCtORbytes/SaGuSDK.git"
  },
  "homepage": "https://vectorbytes.github.io/SaGuDocs/",
  "bugs": {
    "url": "https://github.com/VeCtORbytes/SaGuSDK/issues"
  },
  "peerDependencies": {
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "neo4j-driver": "^5.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "zod": "^3.23.8"
  }
}
